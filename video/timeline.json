 "sentences": [
  {
   "id": "s01",
   "start": 0.3,
   "end": 2.3,
   "text": "Unsold produce is a planning problem.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s02",
   "start": 2.8,
   "end": 4.931,
   "text": "It decides what ships first, and where.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s03",
   "start": 5.381,
   "end": 8.084,
   "text": "Twenty six batches, six markets, one day.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s04",
   "start": 8.484,
   "end": 11.925,
   "text": "Money, spoiled kg, and demand met come first.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s05",
   "start": 12.475,
   "end": 16.166,
   "text": "Against a strong rule-based dispatcher it ties or gains slightly.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s06",
   "start": 16.616,
   "end": 19.211,
   "text": "Most perishable first, with a reason each.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s07",
   "start": 19.711,
   "end": 23.271,
   "text": "If demand is elastic, discounts appear only where they pay.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s08",
   "start": 23.671,
   "end": 25.386,
   "text": "Now, close the biggest market.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s09",
   "start": 25.986,
   "end": 28.641,
   "text": "It replans at once, zero rule breaks.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s10",
   "start": 29.091,
   "end": 33.531,
   "text": "Thirty bad days, plan and rival fixed: on average about even.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s11",
   "start": 34.031,
   "end": 38.293,
   "text": "Held out: plus zero to plus point eight percent versus the best rule.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s12",
   "start": 38.843,
   "end": 42.129,
   "text": "Open assumptions and tested code. This is FreshRoute.",
   "pause_before": 0.0,
   "emphasis": false
  }
 ],
