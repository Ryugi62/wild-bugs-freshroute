 "sentences": [
  {
   "id": "s01",
   "start": 0.3,
   "end": 2.338,
   "text": "Spoiled produce is a planning problem.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s02",
   "start": 2.838,
   "end": 5.088,
   "text": "It decides what ships first, and where.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s03",
   "start": 5.538,
   "end": 8.326,
   "text": "Twenty six batches, six markets, one day.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s04",
   "start": 8.726,
   "end": 11.314,
   "text": "Money, waste, and demand met come first.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s05",
   "start": 11.864,
   "end": 14.076,
   "text": "It beats a careful human dispatcher.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s06",
   "start": 14.526,
   "end": 17.114,
   "text": "Most perishable first, with a reason each.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s07",
   "start": 17.614,
   "end": 19.576,
   "text": "Discounts appear only where they pay.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s08",
   "start": 19.976,
   "end": 21.901,
   "text": "Now, close the biggest market.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s09",
   "start": 22.501,
   "end": 25.276,
   "text": "It replans at once, zero rule breaks.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s10",
   "start": 25.726,
   "end": 27.751,
   "text": "Thirty bad days, it still wins.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s11",
   "start": 28.251,
   "end": 31.339,
   "text": "On hidden data, spoilage falls thirty eight percent.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s12",
   "start": 31.889,
   "end": 35.014,
   "text": "Open assumptions and tested code: FreshRoute.",
   "pause_before": 0.0,
   "emphasis": false
  }
 ],
