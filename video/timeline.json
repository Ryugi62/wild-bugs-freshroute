 "sentences": [
  {
   "id": "s01",
   "start": 0.3,
   "end": 2.74,
   "text": "Unsold produce is a planning problem.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s02",
   "start": 3.24,
   "end": 5.49,
   "text": "It decides what ships first, and where.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s03",
   "start": 5.94,
   "end": 8.728,
   "text": "Twenty six batches, six markets, one day.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s04",
   "start": 9.128,
   "end": 12.676,
   "text": "Money, unsold stock, and demand met come first.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s05",
   "start": 13.226,
   "end": 15.702,
   "text": "It beats a strong rule-based dispatcher.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s06",
   "start": 16.152,
   "end": 18.74,
   "text": "Most perishable first, with a reason each.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s07",
   "start": 19.24,
   "end": 22.978,
   "text": "If demand is elastic, discounts appear only where they pay.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s08",
   "start": 23.378,
   "end": 25.303,
   "text": "Now, close the biggest market.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s09",
   "start": 25.903,
   "end": 28.678,
   "text": "It replans at once, zero rule breaks.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s10",
   "start": 29.128,
   "end": 33.711,
   "text": "Thirty bad days: plan and rival both fixed, it still earns more.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s11",
   "start": 34.211,
   "end": 38.592,
   "text": "On held out data: at least plus point six percent, never worse.",
   "pause_before": 0.0,
   "emphasis": false
  },
  {
   "id": "s12",
   "start": 39.142,
   "end": 43.059,
   "text": "Open assumptions and tested code. This is FreshRoute.",
   "pause_before": 0.0,
   "emphasis": false
  }
 ],
